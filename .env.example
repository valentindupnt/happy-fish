# En local seulement. Sur Vercel, l'intégration Supabase crée ces variables toute seule
# (NEXT_PUBLIC_SUPABASE_URL et NEXT_PUBLIC_SUPABASE_ANON_KEY), que l'app lit aussi.
VITE_SUPABASE_URL=https://xxxx.supabase.co
# Clé publique uniquement (publishable ou anon). Jamais la clé secrète.
VITE_SUPABASE_KEY=sb_publishable_xxxx
